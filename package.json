{
  "name": "nestjs-ai-kit",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:s": "nest build nest-rpc-server",
    "build:c": "nest build nest-rpc-client",
    "build:t": "nest build nest-test-app",
    "proto": "node ./scripts/proto_gen.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:s1": "cross-env PORT=3008  NODE_ENV=dev nest start nest-rpc-server",
    "start:s2": "cross-env PORT=3009  NODE_ENV=dev nest start nest-rpc-server",
    "start:c": "cross-env PORT=3009  NODE_ENV=dev nest start nest-rpc-client",
    "start:dev-s": "cross-env NODE_ENV=dev PORT=3005 nest start --watch nest-rpc-server",
    "start:dev-c": "cross-env NODE_ENV=dev PORT=3005 nest start --watch nest-rpc-client",
    "start:dev-t": "cross-env NODE_ENV=dev PORT=3005 nest start --watch nest-test-app",
    "start:prod-t": "cross-env NODE_ENV=dev PORT=3005 node dist/apps/nest-test-app/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/nest-test-app/test/jest-e2e.json",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org qingying --project node-nestjs ./dist/apps/nest-ai-api && sentry-cli sourcemaps upload --org qingying --project node-nestjs ./dist"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.7.13",
    "@kafkajs/confluent-schema-registry": "^3.8.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.57.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/lodash": "^4.17.16",
    "cluster-key-slot": "^1.1.2",
    "consul": "^2.0.1",
    "dotenv": "^16.4.7",
    "escape-string-regexp": "^5.0.0",
    "express": "^4.21.2",
    "google-protobuf": "^3.21.4",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "ioredis": "^5.6.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "mongodb": "6.15",
    "mongoose": "^8.13.0",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.17.28",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/microrpc(|/.*)$": "<rootDir>/libs/microrpc/src/$1",
      "^@app/utils(|/.*)$": "<rootDir>/libs/utils/src/$1",
      "^y/db(|/.*)$": "<rootDir>/libs/db/src/$1",
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    }
  },
  "packageManager": "yarn@3.4.1+sha512.a333bf9c2557d71f5ba87dd1446cde24bb9c35301ec29dd2baba577b3f9d1ab61348b66a1324de9088c40a996c5b9203794da8bf14cab9fae6a6eccc00cb8078"
}

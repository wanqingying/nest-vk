{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@libs/(.*?)/(.*)$": "<rootDir>/../../../libs/$1/src/$2"
  },
  "testRegex": ".e2e.ts$",
  "testPathPattern": [],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}